<UserControl x:Class="ROITest.Views.RoiEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:ROITest.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Background="#FF1E1E1E"
             ClipToBounds="True">

    <UserControl.Resources>
        <converters:ToolTypeToStringConverter x:Key="ToolTypeToStringConverter"/>
    </UserControl.Resources>

    <Grid>
        <!-- 第 1 层：底图 -->
        <Image x:Name="BackgroundImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="NearestNeighbor"/>

        <!-- 第 2 层：形状渲染画布 -->
        <Canvas x:Name="ShapeCanvas"
                Background="Transparent"
                IsHitTestVisible="False"
                SnapsToDevicePixels="True"/>

        <!-- 第 3 层：交互覆盖层（手柄、框选矩形、多边形预览线） -->
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                SnapsToDevicePixels="True"/>
    </Grid>
</UserControl>