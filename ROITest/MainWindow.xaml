<Window x:Class="ROITest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:ROITest.Converters"
        xmlns:vm="clr-namespace:ROITest.ViewModels"
        xmlns:views="clr-namespace:ROITest.Views"
        mc:Ignorable="d"
        Title="ROI 编辑器"
        Height="700" Width="1000"
        MinHeight="500" MinWidth="700"
        WindowStartupLocation="CenterScreen"
        Background="#FF2D2D30">

    <Window.Resources>
        <converters:EnumToBoolConverter x:Key="EnumToBoolConverter"/>
        <converters:ToolTypeToStringConverter x:Key="ToolTypeToStringConverter"/>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <DockPanel>
        <!-- ═══ 顶部工具栏 ═══ -->
        <ToolBarTray DockPanel.Dock="Top"
                     Background="#FF2D2D30"
                     IsLocked="True">
            <ToolBar Band="0" BandIndex="0"
                     Background="#FF2D2D30"
                     Foreground="White">

                <!-- 绘制工具按钮组 -->
                <ToggleButton x:Name="BtnPointer"
                              Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="指针工具 (V)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Pointer, Mode=TwoWay}">
                    <TextBlock Text="⬚ 指针" FontSize="12"/>
                </ToggleButton>

                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="矩形 (R)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Rectangle, Mode=TwoWay}">
                    <TextBlock Text="▭ 矩形" FontSize="12"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="旋转矩形 (T)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=RotatedRectangle, Mode=TwoWay}">
                    <TextBlock Text="▱ 旋转" FontSize="12"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="圆形 (C)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Circle, Mode=TwoWay}">
                    <TextBlock Text="○ 圆形" FontSize="12"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="椭圆 (E)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Ellipse, Mode=TwoWay}">
                    <TextBlock Text="◎ 椭圆" FontSize="12"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="线段 (L)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Line, Mode=TwoWay}">
                    <TextBlock Text="╱ 线段" FontSize="12"/>
                </ToggleButton>

                <ToggleButton Style="{StaticResource ToolToggleButtonStyle}"
                              ToolTip="多边形 (P)"
                              IsChecked="{Binding Editor.ActiveTool,
                                  Converter={StaticResource EnumToBoolConverter},
                                  ConverterParameter=Polygon, Mode=TwoWay}">
                    <TextBlock Text="⬠ 多边形" FontSize="12"/>
                </ToggleButton>

                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- 操作按钮组 -->
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="撤销 (Ctrl+Z)"
                        Command="{Binding Editor.UndoCommand}">
                    <TextBlock Text="↩ 撤销" FontSize="12"/>
                </Button>

                <Button Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="重做 (Ctrl+Y)"
                        Command="{Binding Editor.RedoCommand}">
                    <TextBlock Text="↪ 重做" FontSize="12"/>
                </Button>

                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <Button Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="删除选中 (Delete)"
                        Command="{Binding Editor.DeleteCommand}">
                    <TextBlock Text="✕ 删除" FontSize="12"/>
                </Button>

                <Separator Style="{StaticResource ToolBarSeparatorStyle}"/>

                <!-- 加载图片按钮 -->
                <Button Style="{StaticResource ToolBarButtonStyle}"
                        ToolTip="加载底图"
                        Click="OnLoadImageClick">
                    <TextBlock Text="📂 加载图片" FontSize="12"/>
                </Button>
            </ToolBar>
        </ToolBarTray>

        <!-- ═══ 底部状态栏 ═══ -->
        <StatusBar DockPanel.Dock="Bottom"
                   Background="#FF007ACC"
                   Foreground="White"
                   Height="24">
            <StatusBarItem>
                <TextBlock>
                    <Run Text="当前工具："/>
                    <Run Text="{Binding Editor.ActiveTool,
                        Converter={StaticResource ToolTypeToStringConverter},
                        Mode=OneWay}"/>
                </TextBlock>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}"/>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══ 主内容区：编辑器 ═══ -->
        <views:RoiEditorControl x:Name="EditorControl"
                                Margin="0"/>
    </DockPanel>
</Window>