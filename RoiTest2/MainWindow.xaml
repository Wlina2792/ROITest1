<Window x:Class="RoiTest2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RoiTest2"
        mc:Ignorable="d"
  
        d:DataContext="{d:DesignInstance Type=local:VM}"
        Title="MainWindow" Height="450" Width="800">
    <Grid RowDefinitions="50 *" >
        <Grid ColumnDefinitions="* * ">
            <UniformGrid >
                <TextBlock Text="{Binding X,Mode=TwoWay}" />
                <TextBlock Text="{Binding Y,Mode=TwoWay}" />
                <TextBlock Text="{Binding W,Mode=TwoWay}" />
                <TextBlock Text="{Binding H,Mode=TwoWay}" />
            </UniformGrid>
            <Button Grid.Column="1" Content="Select" Command="{Binding SelectCommand}" />
        </Grid>
       
        <Canvas Grid.Row="1" Margin="10">
            <local:RectRoiControl
       X="{Binding X}"
       Y="{Binding Y}"
       W="{Binding W}"
       H="{Binding H}"
                IsSelected="{Binding IsSelected,Mode=TwoWay}"
                Background="Red"
                BorderBrush="Blue"
                
                Opacity="0.3"
               
     ></local:RectRoiControl>        </Canvas>
    </Grid>
</Window>
