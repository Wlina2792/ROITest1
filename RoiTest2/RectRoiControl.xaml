<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RoiTest2">

    <!--  Thumb 手柄通用样式  -->
    <Style x:Key="ROIThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="Red" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Rectangle
                        Fill="{TemplateBinding Background}"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  RectRoiControl 控件模板  -->
    <Style TargetType="{x:Type local:RectRoiControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RectRoiControl}">
                    <Canvas Width="{TemplateBinding W}" Height="{TemplateBinding H}">

                        <!--  矩形  -->
                        <local:RectRoiShape
                            Fill="#1677ff"
                            H="{TemplateBinding H}"
                            Opacity="0.6"
                            Stroke="#1677ff"
                            StrokeThickness="1"
                            W="{TemplateBinding W}"
                            X="0"
                            Y="0" />

                        <!--  整体移动手柄：覆盖整个 Canvas  -->
                        <Thumb
                            x:Name="MoveTracker"
                            Canvas.Left="0"
                            Canvas.Top="0"
                            Width="{TemplateBinding W}"
                            Height="{TemplateBinding H}"
                            Background="Transparent"
                            Cursor="SizeAll">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="Transparent" Cursor="SizeAll" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  四个角把手  -->
                        <Thumb
                            x:Name="LeftTopTracker"
                            Cursor="SizeNWSE"
                            Style="{StaticResource ROIThumbStyle}" />

                        <Thumb
                            x:Name="RightTopTracker"
                            Cursor="SizeNESW"
                            Style="{StaticResource ROIThumbStyle}" />

                        <Thumb
                            x:Name="LeftBottomTracker"
                            Cursor="SizeNESW"
                            Style="{StaticResource ROIThumbStyle}" />

                        <Thumb
                            x:Name="RightBottomTracker"
                            Cursor="SizeNWSE"
                            Style="{StaticResource ROIThumbStyle}" />

                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>