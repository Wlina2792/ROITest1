<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:RoiTest2">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <!--  左上  -->
    <Style x:Key="LeftTopThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Path
                        Data="M1,1 L9,1 L9,3 L3,3 L3,9 L1,9 Z"
                        Fill="Red"
                        RenderTransformOrigin="0,0">
                        <Path.RenderTransform>
                            <TranslateTransform X="2" Y="2" />
                        </Path.RenderTransform>
                    </Path>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  右上  -->
    <Style x:Key="RightTopThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Path
                        Data="M1,1 L9,1 L9,9 L7,9 L7,3 L1,3 Z"
                        Fill="Red"
                        RenderTransformOrigin="0,0">
                        <Path.RenderTransform>
                            <TranslateTransform X="-2" Y="2" />
                        </Path.RenderTransform>
                    </Path>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  左下  -->
    <Style x:Key="LeftBottomThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Path
                        Data="M1,1 L3,1 L3,7 L9,7 L9,9 L1,9 Z"
                        Fill="Red"
                        RenderTransformOrigin="0,0">
                        <Path.RenderTransform>
                            <TranslateTransform X="2" Y="-2" />
                        </Path.RenderTransform>
                    </Path>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  右下  -->
    <Style x:Key="RightBottomThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Stylus.IsPressAndHoldEnabled" Value="false" />
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Path
                        Data="M7,1 L9,1 L9,9 L1,9 L1,7 L7,7 Z"
                        Fill="Red"
                        RenderTransformOrigin="0,0">
                        <Path.RenderTransform>
                            <TranslateTransform X="-2" Y="-2" />
                        </Path.RenderTransform>
                    </Path>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--  RectRoiControl 控件模板  -->
    <Style TargetType="{x:Type local:RectRoiControl}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RectRoiControl}">
                    <Canvas Width="{TemplateBinding W}" Height="{TemplateBinding H}">

                        <!--  矩形  -->
                        <local:RectRoiShape
                            Fill="Transparent"
                            H="{TemplateBinding H}"
                           
                            Stroke="{TemplateBinding BorderBrush}"
                            StrokeThickness="1"
                            W="{TemplateBinding W}"
                            X="0"
                            Y="0" />

                        <!--  整体移动手柄：覆盖整个 Canvas  -->
                        <Thumb
                            x:Name="MoveTracker"
                            Canvas.Left="0"
                            Canvas.Top="0"
                              Background="{TemplateBinding Background}"  
                            Width="{TemplateBinding W}"
                            Height="{TemplateBinding H}"        Opacity="{TemplateBinding Opacity}"
                            Cursor="SizeAll"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border Background="{TemplateBinding Background}" Cursor="SizeAll" />
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>

                        <!--  四个角把手：Visibility 直接绑定到 IsSelected  -->
                        <Thumb
                            x:Name="LeftTopTracker"
                            Cursor="SizeNWSE"
                            Style="{StaticResource LeftTopThumbStyle}"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Thumb
                            x:Name="RightTopTracker"
                            Cursor="SizeNESW"
                            Style="{StaticResource RightTopThumbStyle}"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Thumb
                            x:Name="LeftBottomTracker"
                            Cursor="SizeNESW"
                            Style="{StaticResource LeftBottomThumbStyle}"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                        <Thumb
                            x:Name="RightBottomTracker"
                            Cursor="SizeNWSE"
                            Style="{StaticResource RightBottomThumbStyle}"
                            Visibility="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    </Canvas>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>